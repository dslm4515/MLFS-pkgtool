# Final System - Binutils
# Build and install under chroot

# Setup variables for packaging:
export PNM="binutils"
export  PV="2.45.1"

# The Binutils documentation recommends building Binutils in 
# a dedicated build directory: 
mkdir -v build
cd       build

# Set build options
export  CARGS="--prefix=/usr "
export CARGS+="--sysconfdir=/etc "
export CARGS+="--enable-ld=default "
export CARGS+="--enable-plugins "
export CARGS+="--enable-shared "
export CARGS+="--disable-werror "
export CARGS+="--enable-64-bit-bfd "
export CARGS+="--enable-new-dtags "
export CARGS+="--with-system-zlib "
export CARGS+="--enable-default-hash-style=gnu "

# Prepare binutils for compilation: 
../configure $CARGS

# Compile the package: 
make tooldir=/usr

# Install to the staging area:
make DESTDIR=$BUILD tooldir=/usr install

# Build the pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM} ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}-${PV}-${PF64}

# Install to system
spkg ${PKGS}/${PNM}-${PV}-${PF64}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

