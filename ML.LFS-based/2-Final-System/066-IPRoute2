# Final System - IPRoute2
# Build and install under chroot

# Setup variables for packaging:
export PNM="iproute2"
export  PV="7.1.0"

# Per LFS: The arpd program included in this package will not 
# be built since it depends on Berkeley DB, which is not 
# installed in LFS. However, a directory and a man page for 
# arpd will still be installed. Prevent this by running the 
# commands shown below. 
sed -i /ARPD/d Makefile
rm -fv man/man8/arpd.8

# Compile the package: 
make NETNS_RUN_DIR=/run/netns

# Install to the staging area:
make DESTDIR=$BUILD SBINDIR=/usr/sbin install

# Build the pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM} ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}-${PV}-${PF64}

# Install to system
spkg ${PKGS}/${PNM}-${PV}-${PF64}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

