# Final System - Ncurses 64-bit & 32-bit
# Build and install under chroot

# Setup variables for packaging:
export PNM="ncurses"
export  PV="6.6"

# Set the build options
export  CARGS="--prefix=/usr "
export CARGS+="--mandir=/usr/share/man "
export CARGS+="--with-shared "
export CARGS+="--without-debug "
export CARGS+="--without-normal "
export CARGS+="--with-cxx-shared "
export CARGS+="--enable-pc-files "
export CARGS+="--with-pkg-config-libdir=/usr/lib/pkgconfig "

# Prepare ncurses for 64-bit compilation: 
./configure $CARGS

# Compile the package: 
make 

# Install to the staging area:
make DESTDIR=$BUILD install

# Edit header to ensure the wide-character ABI to be used
sed -e 's/^#if.*XOPEN.*$/#if 1/' \
    -i $BUILD/usr/include/curses.h

# Many applications still expect the linker to be able to find 
# non-wide-character Ncurses libraries. Trick such applications into 
# linking with wide-character libraries by means of symlinks (note that 
# the .so links are only safe with curses.h edited to always use the 
# wide-character ABI):
for lib in ncurses form panel menu ; do
    ln -sfv lib${lib}w.so $BUILD/usr/lib/lib${lib}.so
    ln -sfv ${lib}w.pc    $BUILD/usr/lib/pkgconfig/${lib}.pc
done

# Finally, make sure that old applications that look for -lcurses at build 
# time are still buildable: 
ln -sfv libncursesw.so $BUILD/usr/lib/libcurses.so

# Build the 64-bit pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM} ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}-${PV}-${PF64}

# Install to system
spkg ${PKGS}/${PNM}-${PV}-${PF64}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

# Return to source tree
cd -

## 32-bit build

# Clean previous build: 
make distclean

# Set 32-bit build options
export  CARGS="--prefix=/usr "
export CARGS+="--mandir=/usr/share/man "
export CARGS+="--with-shared "
export CARGS+="--without-debug "
export CARGS+="--without-normal "
export CARGS+="--with-cxx-shared "
export CARGS+="--enable-pc-files "
export CARGS+="--with-pkg-config-libdir=/usr/lib32/pkgconfig "
export CARGS+="--libdir=/usr/lib32 "
export CARGS+="--libexecdir=/usr/lib32 "
export CARGS+="--host=i686-pc-linux-gnu "

# Prepare ncurses for 32-bit compilation:
CC="gcc -m32" CXX="g++ -m32" ./configure $CARGS

# Compile the 32-bit libraries: 
make 

# Install 32-bit libraries
make DESTDIR=$PWD/DESTDIR install
mkdir -p DESTDIR/usr/lib32/pkgconfig
for lib in ncurses form panel menu ; do
    rm -vf                    DESTDIR/usr/lib32/lib${lib}.so
    echo "INPUT(-l${lib}w)" > DESTDIR/usr/lib32/lib${lib}.so
    ln -svf ${lib}w.pc        DESTDIR/usr/lib32/pkgconfig/$lib.pc
done
rm -vf                     DESTDIR/usr/lib32/libcursesw.so
echo "INPUT(-lncursesw)" > DESTDIR/usr/lib32/libcursesw.so
ln -sfv libncurses.so      DESTDIR/usr/lib32/libcurses.so
mkdir -pv $BUILD/usr/lib32
cp -Rv DESTDIR/usr/lib32/* $BUILD/usr/lib32
rm -rf DESTDIR

# Build the 32-bit pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM}_32 ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}_32-${PV}-${PF32}

# Install to system
spkg ${PKGS}/${PNM}-${PV}_32-${PF32}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi


