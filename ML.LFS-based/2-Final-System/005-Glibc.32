# Final System - Glibc 32-bit
# Build and install under chroot

# Setup variables for packaging:
export PNM="glibc"
export  PV="2.42"

# Clear the build directory and remove artefacts from previous build:
cd /sources/glibc*/build
rm -rf ./*
find .. -name "*.a" -delete

# Set the build options
export  CARGS="--prefix=/usr "
export CARGS+="--host=i686-pc-linux-gnu "
export CARGS+="--build=$(../scripts/config.guess) "
export CARGS+="--libdir=/usr/lib32 "
export CARGS+="--libexecdir=/usr/lib32 "
export CARGS+="--disable-werror "
export CARGS+="--disable-nscd "
export CARGS+="--enable-stack-protector=strong "
export CARGS+="--enable-kernel=5.4 "
export CARGS+="libc_cv_slibdir=/usr/lib32 "

# Prepare Glibc for compilation:
CC="gcc -m32 -ffile-prefix-map=/tools=/usr" \
CXX="g++ -m32 -ffile-prefix-map=/tools=/usr" \
../configure $CARGS
unset CARGS

# Install the package:
make DESTDIR=$PWD/DESTDIR install
mkdir -pv ${BUILD}/usr/include/gnu
cp -a DESTDIR/usr/lib32 $BUILD/usr/
install -vm644 DESTDIR/usr/include/gnu/{lib-names,stubs}-32.h \
               ${BUILD}/usr/include/gnu/

# Add the library name to the dynamic loader config:
echo "/usr/lib32" >> /etc/ld.so.conf

# Make sure 32-bit binaries can find the 32-bit dynamic interpreter
ln -sv ../lib32/ld-linux.so.2 $BUILD/usr/lib/ld-linux.so.2

# Build the pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install           && \
cp -v $DESCS/${PNM} ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}-${PV}-${PF32}

# Install to system
spkg ${PKGS}/${PNM}_32-${PV}-${PF32}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

# At this point, it is imperative to stop and ensure that the basic functions (compiling and linking) of the new toolchain are working as expected. To perform a sanity check, run the following commands:
echo 'int main(){}' > dummy.c
gcc -m32 dummy.c
readelf -l a.out | grep '/ld-linux'

# If everything is working correctly, there should be no errors, and the output of the last command will be of the form:
# [Requesting program interpreter: /tools/lib/ld-linux.so.2]

# Once all is well, clean up the test files:
rm -v dummy.c a.out
