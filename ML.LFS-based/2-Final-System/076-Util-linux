# Final System - Util-Linux
# Build and install under chroot

# Setup variables for packaging:
export PNM="util-linux"
export  PV="2.42.2"

# Prepare util-linux for 64-bit compilation: 
export  CARGS="--bindir=/usr/bin "
export CARGS+="--libdir=/usr/lib "
export CARGS+="--runstatedir=/run "
export CARGS+="--sbindir=/usr/sbin "
export CARGS+="--disable-chfn-chsh "
export CARGS+="--disable-login "
export CARGS+="--disable-nologin "
export CARGS+="--disable-su "
export CARGS+="--disable-setpriv "
export CARGS+="--disable-runuser "
export CARGS+="--disable-pylibmount "
export CARGS+="--disable-liblastlog2 "
export CARGS+="--disable-static "
export CARGS+="--without-python "
export CARGS+="--docdir=/usr/share/doc/util-linux-2.42.2 "

./configure $CARGS ADJTIME_PATH=/var/lib/hwclock/adjtime

# Compile the package: 
make 

# Install to the staging area:
make DESTDIR=$BUILD install

# Build the pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM} ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}-${PV}-${PF64}

# Install to system
spkg ${PKGS}/${PNM}-${PV}-${PF64}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

# Return to source tree
cd -

## 32-bit build

# Clean previous build:
make distclean

# Per LFS, Move a tool out of the way which is optionally 
# used by configure but will report invalid paths for 
# multilib builds.
mv /usr/bin/ncursesw6-config{,.tmp}

# Prepare Util-linux for 32-bit compilation: 
export CARGS+="--host=i686-pc-linux-gnu "
export CARGS+="--libdir=/usr/lib32 "
  
CC="gcc -m32" ./configure $CARGS ADJTIME_PATH=/var/lib/hwclock/adjtime

# Restore the tool previously moved away: 
mv /usr/bin/ncursesw6-config{.tmp,}

# Compile the package:
make

# Install the 32-bit libraries: 
make DESTDIR=$PWD/DESTDIR install
mkdir -pv $BUILD/usr/lib32
cp -Rv DESTDIR/usr/lib32/* $BUILD/usr/lib32
rm -rf DESTDIR

# Build the 32-bit pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM}_32 ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}_32-${PV}-${PF32}

# Install to system
spkg ${PKGS}/${PNM}-${PV}_32-${PF32}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

