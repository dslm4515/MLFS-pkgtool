# Final System - Pkgconf
# Build and install under chroot

# Setup variables for packaging:
export PNM="pkgconf"
export  PV="2.5.1"

# Set build options
export  CARGS="--prefix=/usr "
export CARGS+="--disable-static "
export CARGS+="--docdir=/usr/share/doc/pkgconf-2.5.1 "

# Prepare pkgconf for compilation: 
./configure $CARGS

# Compile the package: 
make 

# Install to the staging area:
make DESTDIR=$BUILD install

# To maintain compatibility with the original Pkg-config 
# create two symlinks: 
ln -sv pkgconf   $BUILD/usr/bin/pkg-config
ln -sv pkgconf.1 $BUILD/usr/share/man/man1/pkg-config.1

# When targetting the 32-bit architectures on 64-bit, some 
# packages will use Pkg-config in a way that will pull in 
# libraries that have only been built for 64-bit. This 
# spirals into linker or other errors. This can be fixed 
# by creating Pkg-config personalities which can then be 
# used to override default Pkg-config behavior. Create 
# them now:
ln -sv pkgconf $BUILD/usr/bin/i686-pc-linux-gnu-pkg-config
ln -sv pkgconf $BUILD/usr/bin/x86_64-pc-linux-gnu-pkg-config
 
mkdir -pv $BUILD/usr/share/pkgconfig/personality.d
 
cat > $BUILD/usr/share/pkgconfig/personality.d/i686-pc-linux-gnu.personality << EOF
Triplet: i686-pc-linux-gnu 
SysrootDir: /
DefaultSearchPaths: /usr/lib32/pkgconfig:/usr/share/pkgconfig
SystemIncludePaths: /usr/include
SystemLibraryPaths: /usr/lib32
EOF 
 
cat > $BUILD/usr/share/pkgconfig/personality.d/x86_64-pc-linux-gnu.personality << EOF
Triplet: x86_64-pc-linux-gnu
SysrootDir: /
DefaultSearchPaths: /usr/lib/pkgconfig:/usr/share/pkgconfig
SystemIncludePaths: /usr/include
SystemLibraryPaths: /usr/lib
EOF

# Build the pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM} ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}-${PV}-${PF64}

# Install to system
spkg ${PKGS}/${PNM}-${PV}-${PF64}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

