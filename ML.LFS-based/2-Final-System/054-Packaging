# Final System - Packaging
# Build and install under chroot

# Setup variables for packaging:
export PNM="packaging"
export  PV="26.3"

# Compile the package: 
pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD

# Install to the staging area:
pip3 install --no-index --find-links dist packaging --root=$BUILD

# Build the pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM} ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}-${PV}-${PFNA}

# Install to system
spkg ${PKGS}/${PNM}-${PV}-${PFNA}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

