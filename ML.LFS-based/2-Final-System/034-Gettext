# Final System - Gettext
# Build and install under chroot

# Setup variables for packaging:
export PNM="gettext"
export  PV="1.0"

# Prepare gettext for compilation: 
export  CARGS="--prefix=/usr "
export CARGS+="--disable-static "
export CARGS+="--docdir=/usr/share/doc/gettext-1.0 "
./configure $CARGS
unset CARGS

# Fails to configure. Workaround:
cd gettext-tools/examples
# remove lines 518 -> 551
sed -i '518,551d'config.status
./config.status
cd -

# Compile the package: 
make 

# Install to the staging area:
make DESTDIR=$BUILD install
chmod -v 0755 $BUILD/usr/lib/preloadable_libintl.so

# Build the pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM} ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}-${PV}-${PF64}

# Install to system
spkg ${PKGS}/${PNM}-${PV}-${PF64}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

