# Final System - Procps-ng
# Build and install under chroot

# Setup variables for packaging:
export PNM="procps-ng"
export  PV="4.0.7"

# Prepare procps-ng for compilation: 
export  CARGS="--prefix=/usr "
export CARGS+="--disable-static "
export CARGS+="--disable-kill "
export CARGS+="--enable-watch8bit "
export CARGS+="--docdir=/usr/share/doc/procps-ng-4.0.7 "

./configure $CARGS
unset CARGS

# Compile the package: 
make 

# Install to the staging area:
make DESTDIR=$BUILD install

# Build the pacakage
cd ${BUILD} && mkdir -v ${BUILD}/install         && \
cp -v $DESCS/${PNM} ${BUILD}/install/slack-desc  && \
makepkg -l y -c n ${PKGS}/${PNM}-${PV}-${PF64}

# Install to system
spkg ${PKGS}/${PNM}-${PV}-${PF64}

# Clean staging area
if [ $BUILD ]; then rm -rf ${BUILD}/* ; fi

